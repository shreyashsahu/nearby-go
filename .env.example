# MAPS_API_KEY: Optional Google Maps Platform API key (Geocoding, Places, Routes).
# Set this in the AI Studio Secrets panel for live Maps geocoding and route calculations.
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# RAZORPAY_KEY_ID: Optional Razorpay Test Mode Key ID (e.g., rzp_test_...).
# Set this in the AI Studio Secrets panel for Razorpay test checkout integration.
RAZORPAY_KEY_ID=YOUR_RAZORPAY_TEST_KEY_ID
